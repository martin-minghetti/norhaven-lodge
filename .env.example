# Supabase Postgres connection (pooler URL recommended for Vercel)
DATABASE_URL=postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:6543/postgres

# Supabase public keys (solo si vas a usar supabase-js además de Drizzle).
# Si dejás vacío y no importás supabase-js, la app funciona igual.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment mode: "simulated" (demo público sin MP real) o "production" (MP Checkout Pro real)
PAYMENT_MODE=simulated

# MercadoPago — solo se usan si PAYMENT_MODE=production
MP_ACCESS_TOKEN=APP_USR-xxxxx-or-TEST-xxxxx
MP_WEBHOOK_SECRET=
# MP_MODE: "sandbox" usa sandbox_init_point con tokens de prueba; "production" usa init_point real
MP_MODE=sandbox

# Booking token secret — firma URLs de simulated-checkout (HMAC-SHA256)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_TOKEN_SECRET=

# Resend (free tier — usar dominio resend.dev al inicio)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Norhaven <onboarding@resend.dev>

# Google Gemini (free tier 1500 req/día sin tarjeta)
GOOGLE_GENERATIVE_AI_API_KEY=

# Public site URL (used for MP redirects + emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
